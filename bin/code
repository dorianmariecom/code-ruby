#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/code-ruby"
require "dorian/arguments"
require "pp"

parsed =
  Dorian::Arguments.parse(
    format: {
      type: :boolean,
      alias: :f
    },
    input: {
      type: :string,
      alias: :i
    },
    parse: {
      type: :boolean,
      alias: :p
    },
    profile: :boolean,
    profiler: :string,
    timeout: {
      type: :integer,
      alias: :t
    },
    version: {
      type: :boolean,
      alias: :v
    },
    help: {
      type: :boolean,
      alias: :h
    }
  )

abort Code::Version.to_s if parsed.options.version
abort parsed.help if parsed.options.help

def glob_pattern?(value)
  value.match?(/[*?\[\]{]/)
end

def timeout
  @timeout ||= @parsed_timeout
end

def with_timeout(&)
  Timeout.timeout(timeout, &)
rescue Timeout::Error
  raise Code::Error, "timeout"
end

def read_file(path)
  raise Code::Error, "#{path} is not a regular file" unless File.file?(path)

  File.open(path, "rb") do |file|
    file.read.to_s
  end
end

def read_stdin
  $stdin.read.to_s
end

def expand_arguments(arguments)
  expanded_files = []
  remaining_arguments = []

  arguments.each do |argument|
    if glob_pattern?(argument)
      matches = Dir.glob(argument).select { |path| File.file?(path) }

      if matches.any?
        expanded_files.concat(matches)
      else
        remaining_arguments << argument
      end
    else
      remaining_arguments << argument
    end
  end

  [expanded_files, remaining_arguments]
end

begin
  @parsed_timeout =
    Code.normalize_timeout!(parsed.options.timeout || Code::DEFAULT_TIMEOUT)
rescue Code::Error => e
  abort "#{e.class}: #{e.message}"
end

begin
  input =
    with_timeout do
      buffer = +""
      option_input = parsed.options.input.to_s
      expanded_argument_files, remaining_arguments =
        expand_arguments(parsed.arguments)

      buffer <<
        if option_input.present? && File.exist?(option_input)
          read_file(option_input)
        else
          option_input
        end

      buffer << remaining_arguments.join(" ")

      input_files = parsed.files + expanded_argument_files

      input_files.each.with_index do |file, index|
        buffer << "\n\n" if index.positive?
        buffer << read_file(file)
      end

      buffer
    end
rescue Code::Error => e
  abort "#{e.class}: #{e.message}"
end

profile = parsed.options.profile || parsed.options.profiler
require "ruby-prof" if profile

RubyProf.start if profile

begin
  input = with_timeout { read_stdin } if input.empty?
rescue Code::Error => e
  abort "#{e.class}: #{e.message}"
end

if parsed.options.parse
  begin
    output = StringIO.new
    with_timeout { PP.pp(Code.parse(input, timeout: timeout), output) }
    print output.string
  rescue SystemStackError
    warn "timeout"
  rescue StandardError => e
    warn e.message
  end
elsif parsed.options.format
  begin
    print(Code.format(input, timeout: timeout))
  rescue Code::Error => e
    warn "#{e.class}: #{e.message}"
  end
else
  begin
    print(
      Code.evaluate(
        input,
        output: $stdout,
        error: $stderr,
        input: $stdin,
        timeout: timeout
      )
    )
  rescue Code::Error => e
    warn "#{e.class}: #{e.message}"
  end
end

if profile
  result = RubyProf.stop

  printer =
    if parsed.options.profiler == "html"
      RubyProf::GraphHtmlPrinter.new(result)
    else
      RubyProf::FlatPrinter.new(result)
    end
  printer.print($stdout)
end
